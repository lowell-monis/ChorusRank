# ==============================================================================
# ChorusRank Configuration & Credentials Template
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
# ==============================================================================

# Primary Storage Backend: "mongodb" (NoSQL primary) or "parquet" (local fallback)
STORAGE_BACKEND=mongodb

# MongoDB Atlas Connection URI
# Option A: Standard username/password connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority

# Option B: X.509 Certificate authentication (uncomment if using certificates)
# MONGO_URI=mongodb+srv://<cluster-url>/?authSource=%24external&authMechanism=MONGODB-X509&appName=chorusrank
# CERT_FILE_PATH=certs/X509-cert.pem

# Target Database Name
MONGO_DB_NAME=chorusrank

# Bluesky & AT Protocol Endpoints
JETSTREAM_URI=wss://jetstream2.us-east.bsky.network/subscribe
PUBLIC_XRPC_URI=https://public.api.bsky.app/xrpc
